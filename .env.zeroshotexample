# Example configuration for zero-shot voice cloning with alternative model
# Copy this to .env if you want to test zero-shot with a different model

# Standard Orpheus settings (keep these as-is)
ORPHEUS_API_URL=http://127.0.0.1:1234/v1/completions
ORPHEUS_API_TIMEOUT=120
ORPHEUS_MAX_TOKENS=8192
ORPHEUS_TEMPERATURE=0.6
ORPHEUS_TOP_P=0.9
ORPHEUS_SAMPLE_RATE=24000
ORPHEUS_MODEL_NAME=Orpheus-3b-FT-Q8_0.gguf
ORPHEUS_PORT=5005
ORPHEUS_HOST=0.0.0.0

# Zero-shot voice cloning with alternative model
# NOTE: The default Orpheus model has tokenizer compatibility issues
# You would need to use a different model or wait for a fix
ORPHEUS_ENABLE_MODEL_INFERENCE=true

# Example alternative models (these would need TTS fine-tuning to work properly):
# ORPHEUS_MODEL_HF=meta-llama/Llama-2-7b-hf
# ORPHEUS_MODEL_HF=mistralai/Mistral-7B-v0.1
# ORPHEUS_MODEL_HF=microsoft/phi-2

# For now, keep it disabled since the Orpheus tokenizer is incompatible
ORPHEUS_MODEL_HF=canopylabs/orpheus-3b-0.1-pretrained